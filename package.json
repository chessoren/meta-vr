{
  "name": "loci",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Loci — turn your real room into a memory palace. Mixed reality spaced-repetition for Meta Quest and Meta VR Glasses.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@iwsdk/core": "1.0.0",
    "@lichess-org/vosk-browser": "^0.0.3",
    "pdfjs-dist": "^6.3.289",
    "qrcode-generator": "^2.0.4",
    "three": "npm:super-three@0.181.0"
  },
  "devDependencies": {
    "@iwer/sem": "^2.5.0",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.10.0",
    "@types/three": "^0.181.0",
    "@vercel/node": "^16.0.2",
    "iwer": "^2.5.0",
    "typescript": "^5.6.0",
    "vite": "^7.1.4",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "three": "$three"
  }
}
